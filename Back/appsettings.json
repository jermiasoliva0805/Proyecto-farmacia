{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=FarmaciaDB;Integrated Security=true;TrustServerCertificate=True;"
  },
  "AppSettings": {
    "Token": "${JWT_TOKEN}",
    "FrontendUrl": "${FRONTEND_URL}"
  },
  "Smtp": {
    "Host": "${SMTP_HOST}",
    "Port": 587,
    "User": "${SMTP_USER}",
    "Password": "${SMTP_PASSWORD}",
    "EnableSsl": true
  }
}