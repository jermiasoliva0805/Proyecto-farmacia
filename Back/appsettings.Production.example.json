{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_CONNECTION_STRING}"
  },
  "AppSettings": {
    "Token": "${JWT_TOKEN}",
    "FrontendUrl": "${FRONTEND_URL}"
  },
  "Smtp": {
    "Host": "${SMTP_HOST}",
    "Port": 587,
    "User": "${SMTP_USER}",
    "Password": "${SMTP_PASSWORD}",
    "EnableSsl": true
  }
}
