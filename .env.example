# Base de datos
DATABASE_CONNECTION_STRING=Server=your-server;Database=FarmaciaDB;User Id=your-user;Password=your-password;Encrypt=true;

# JWT
JWT_TOKEN=your-secret-key-at-least-64-characters-long-for-hmac-sha512

# Frontend
FRONTEND_URL=https://your-frontend-domain.com

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-generated-password
